# Separate server configuration. Original .env/.env.local are retained unchanged.
# Previous prototype configuration (reference only; do not copy old secrets):
# DATABASE_URL=postgresql://<owner>:<password>@<neon-host>/neondb?sslmode=require
# FILE_STORAGE_DRIVER=vercel-blob
# BLOB_READ_WRITE_TOKEN=<prototype-token>
# BETTER_AUTH_BASE_URL=https://deferral-dms.vercel.app
# NEXT_PUBLIC_APP_URL=https://deferral-dms.vercel.app
# Old local database published port: 5433; new database is private to Docker.

# Run node deploy/init-env.mjs to generate .env.docker with random secrets.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_HEX
CRON_SECRET=REPLACE_WITH_RANDOM_HEX
# The exact browser URL, including port where needed. No trailing slash.
APP_URL=http://localhost:8080
# Default: only accessible from the server; IT's HTTPS proxy forwards here.
# For temporary LAN HTTP testing, change to 0.0.0.0 and set APP_URL to server IP.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
MAX_FILE_SIZE=5242880
